# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
# Web terminal port and bind address. Leave WEB_BIND_HOST at 127.0.0.1 for a single-machine
# setup. For LAN access from other devices, prefer the self-signed HTTPS overlay below
# (browsers treat plain-HTTP LAN addresses as an insecure context, which breaks parts of the UI).
WEB_PORT=3001
WEB_BIND_HOST=127.0.0.1
# LAN HTTPS overlay (docker-compose.lan-https.yml). Set to this machine's LAN IP or hostname,
# then also set WEB_ORIGIN / PUBLIC_APP_URL to https://<that value>. To load the overlay on
# every command, set COMPOSE_FILE (note the OS-specific separator):
#   Windows:      COMPOSE_FILE=docker-compose.yml;docker-compose.lan-https.yml
#   Linux/macOS:  COMPOSE_FILE=docker-compose.yml:docker-compose.lan-https.yml
LAN_HTTPS_HOST=
LAN_HTTPS_BIND=0.0.0.0
# Required only with docker-compose.production.yml. The production profile
# refuses to start without a real public hostname and ACME contact address.
PUBLIC_APP_HOST=
ACME_EMAIL=
TIMEZONE=Asia/Kolkata
APPLICATION_MODE=PAPER
LIVE_TRADING_ENABLED=false
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO

# PostgreSQL (never expose this port outside the local machine)
POSTGRES_DB=intraday_sentinel
POSTGRES_USER=intraday_sentinel
POSTGRES_PASSWORD=change-this-to-a-strong-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://intraday_sentinel:change-this-to-a-strong-local-password@postgres:5432/intraday_sentinel

# Redis (never expose this port outside the local machine)
REDIS_URL=redis://redis:6379/0

# Authentication -- replace before the first login
JWT_SECRET=generate-a-long-random-secret-with-openssl-or-powershell
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_MINUTES=15

# Firstock: configure through Settings in a later phase. Do not use NEXT_PUBLIC_ variables.
FIRSTOCK_API_KEY=
FIRSTOCK_VENDOR_CODE=
FIRSTOCK_USER_ID=
FIRSTOCK_PASSWORD=
FIRSTOCK_TOTP_SECRET=
# Pipe-separated V2 market-feed instrument tokens, e.g. NSE:26000|NSE:2885.
# Leave blank until valid tokens have been confirmed through Firstock's instrument lookup.
FIRSTOCK_SUBSCRIPTIONS=
# Keep Firstock disabled by default. It remains available for future evaluation;
# this application has no live-order path.

# Upstox primary PAPER market-data connector. The access token is short-lived and
# must be generated through the Upstox Developer App/OAuth flow; never expose it.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only for browser-based OAuth renewal; keep this server-only and stable.
UPSTOX_TOKEN_ENCRYPTION_KEY=
# Automatic headless token renewal at 08:30 AM IST on every business day.
# Requires mobile number, PIN, and TOTP secret from your Upstox account.
UPSTOX_MOBILE_NUMBER=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
# Set to true to enable the morning auto-renewal scheduler.
UPSTOX_AUTO_AUTH_ENABLED=false
# Comma-separated Upstox instrument_key values, e.g. NSE_INDEX|Nifty 50,NSE_EQ|INE002A01018
UPSTOX_SUBSCRIPTIONS=
UPSTOX_NIFTY_BENCHMARK_KEY=NSE_INDEX|Nifty 50
UPSTOX_INSTRUMENT_REFRESH_HOURS=24
# Completed-candle calculation settings. Keep NIFTY in FIRSTOCK_SUBSCRIPTIONS
# whenever relative strength or NIFTY regime is required.
NIFTY_BENCHMARK_TOKEN=NSE:26000
CANDLE_TIMEFRAME_SECONDS=60
OPENING_RANGE_MINUTES=15
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
VOLUME_LOOKBACK_CANDLES=20
# Wilder ATR length (in completed candles) for volatility-aware stops and scoring.
ATR_PERIOD=14
# Completed daily candles fetched on Upstox startup for prior-day levels, gaps and daily ATR.
DAILY_HISTORY_SESSIONS=40
# Prior sessions averaged for the time-of-day relative-volume baseline (needs accumulated 1m history).
RVOL_BASELINE_SESSIONS=10

# Dynamic scan universe. While disabled the scanner evaluates every streamed instrument.
# When enabled, a pre-open job ranks the streamed instruments (liquidity, volatility, gap,
# momentum) and the scanner only generates signals for the top UNIVERSE_SIZE names.
UNIVERSE_ENABLED=false
UNIVERSE_SIZE=30
UNIVERSE_REFRESH_TIME=09:25
UNIVERSE_MIN_AVG_TURNOVER=250000000
UNIVERSE_MIN_PRICE=40
UNIVERSE_MAX_PRICE=15000
UNIVERSE_MIN_ATR_PERCENT=0.8
UNIVERSE_MAX_ATR_PERCENT=8.0

# Composite market regime (intraday NIFTY structure + India VIX + breadth). While disabled the
# scanner uses only the intraday NIFTY EMA/VWAP regime. When enabled it also gates allowed sides
# and scales risk per trade down in a stressed regime. India VIX must be in UPSTOX_SUBSCRIPTIONS
# or it is force-added to the feed.
MARKET_REGIME_ENABLED=false
UPSTOX_INDIA_VIX_KEY=NSE_INDEX|India VIX
INDIA_VIX_CALM_BELOW=13
INDIA_VIX_STRESSED_ABOVE=18
INDIA_VIX_EXTREME_ABOVE=25

# NSE cash-market calendar. The bundled 2026 holidays come from NSE circular
# NSE/CMTR/71775 plus announced amendments. Confirm each new year before adding it.
NSE_CALENDAR_CONFIRMED_YEARS=2026
# Additional full-day closures: comma-separated ISO dates.
NSE_HOLIDAY_OVERRIDES=
# Special sessions: comma-separated YYYY-MM-DD@HH:MM-HH:MM entries in Asia/Kolkata.
NSE_SPECIAL_SESSIONS=

# Market-data quality gates. INVALID or STALE data can never create a signal.
DATA_QUALITY_STALE_AFTER_SECONDS=20
DATA_QUALITY_MAX_TICK_LATENCY_MS=5000
DATA_QUALITY_MAX_MISSING_BARS=0
DATA_QUALITY_MAX_DUPLICATE_PERCENT=10

# Dedicated Telegram bot integration. Outbound alerts require token + chat ID.
# Inbound actions require a publicly reachable HTTPS webhook, secret and allowed IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Inbound callbacks use a dedicated bot webhook; do not reuse a bot that polls getUpdates.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs authorized for Approve/Reject/Stop callbacks.
TELEGRAM_ALLOWED_USER_IDS=
# Required only when storing the bot token/chat ID through the protected API.
TELEGRAM_CONFIG_ENCRYPTION_KEY=
# Suppress duplicate paper-signal notifications for this interval.
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
