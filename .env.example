# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
APPLICATION_MODE=PAPER
LIVE_TRADING_ENABLED=false
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO

# PostgreSQL (never expose this port outside the local machine)
POSTGRES_DB=intraday_sentinel
POSTGRES_USER=intraday_sentinel
POSTGRES_PASSWORD=change-this-to-a-strong-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://intraday_sentinel:change-this-to-a-strong-local-password@postgres:5432/intraday_sentinel

# Redis (never expose this port outside the local machine)
REDIS_URL=redis://redis:6379/0

# Authentication -- replace before the first login
JWT_SECRET=generate-a-long-random-secret-with-openssl-or-powershell
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_MINUTES=15

# Firstock: configure through Settings in a later phase. Do not use NEXT_PUBLIC_ variables.
FIRSTOCK_API_KEY=
FIRSTOCK_VENDOR_CODE=
FIRSTOCK_USER_ID=
FIRSTOCK_PASSWORD=
FIRSTOCK_TOTP_SECRET=
# Pipe-separated V2 market-feed instrument tokens, e.g. NSE:26000|NSE:2885.
# Leave blank until valid tokens have been confirmed through Firstock's instrument lookup.
FIRSTOCK_SUBSCRIPTIONS=
# Keep Firstock disabled by default. It remains available for future evaluation;
# this application has no live-order path.

# Upstox primary PAPER market-data connector. The access token is short-lived and
# must be generated through the Upstox Developer App/OAuth flow; never expose it.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only for browser-based OAuth renewal; keep this server-only and stable.
UPSTOX_TOKEN_ENCRYPTION_KEY=
# Comma-separated Upstox instrument_key values, e.g. NSE_INDEX|Nifty 50,NSE_EQ|INE002A01018
UPSTOX_SUBSCRIPTIONS=
UPSTOX_NIFTY_BENCHMARK_KEY=NSE_INDEX|Nifty 50
UPSTOX_INSTRUMENT_REFRESH_HOURS=24
# Completed-candle calculation settings. Keep NIFTY in FIRSTOCK_SUBSCRIPTIONS
# whenever relative strength or NIFTY regime is required.
NIFTY_BENCHMARK_TOKEN=NSE:26000
CANDLE_TIMEFRAME_SECONDS=60
OPENING_RANGE_MINUTES=15
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
VOLUME_LOOKBACK_CANDLES=20

# NSE cash-market calendar. The bundled 2026 holidays come from NSE circular
# NSE/CMTR/71775 plus announced amendments. Confirm each new year before adding it.
NSE_CALENDAR_CONFIRMED_YEARS=2026
# Additional full-day closures: comma-separated ISO dates.
NSE_HOLIDAY_OVERRIDES=
# Special sessions: comma-separated YYYY-MM-DD@HH:MM-HH:MM entries in Asia/Kolkata.
NSE_SPECIAL_SESSIONS=

# Market-data quality gates. INVALID or STALE data can never create a signal.
DATA_QUALITY_STALE_AFTER_SECONDS=20
DATA_QUALITY_MAX_TICK_LATENCY_MS=5000
DATA_QUALITY_MAX_MISSING_BARS=0
DATA_QUALITY_MAX_DUPLICATE_PERCENT=10

# Dedicated Telegram bot integration. Outbound alerts require token + chat ID.
# Inbound actions require a publicly reachable HTTPS webhook, secret and allowed IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Inbound callbacks use a dedicated bot webhook; do not reuse a bot that polls getUpdates.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs authorized for Approve/Reject/Stop callbacks.
TELEGRAM_ALLOWED_USER_IDS=
# Required only when storing the bot token/chat ID through the protected API.
TELEGRAM_CONFIG_ENCRYPTION_KEY=
# Suppress duplicate paper-signal notifications for this interval.
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
